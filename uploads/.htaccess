# All uploaded files must be served through authenticated application routes.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes

# Uploaded scripts must never execute.
php_flag engine off

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
