# RMS Environment Configuration Template
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_USER=your_database_user
DB_PASS=your_database_password
DB_NAME=rms_db

# Application Configuration
SITE_URL=http://localhost/rms/
SITE_NAME="Research Management System"
SITE_TITLE="RMS - Your Research Platform"

# Session Configuration
SESSION_TIMEOUT=1800

# Email Configuration
# Choose: smtp or mail (PHP mail function)
MAIL_MAILER=mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@rms.edu.ph
MAIL_FROM_NAME="RMS System"
MAIL_REPLY_TO=support@rms.edu.ph

# Upload Configuration
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png

# Security Configuration
BCRYPT_COST=12
# Generate 32 random bytes and store as 64 hexadecimal characters.
# This key protects the one-way attendee ID hashes used to prevent duplicate QR check-ins.
ACTIVITY_CHECKIN_HASH_KEY=
# Optional absolute base URL reachable by attendee devices; defaults to SITE_URL.
# Example on a local network: http://192.168.1.25/rms/
ACTIVITY_CHECKIN_BASE_URL=

# Initial default for the Admin System Settings DOCX-generation control; saved database value takes precedence.
EARIST_LIVE_GENERATION_ENABLED=0

# Optional Faculty Google Drive/Docs editing for generated EARIST DOCX files.
# Create an OAuth web application in Google Cloud and register the callback URL
# shown in docs/EARIST_GOOGLE_DOCS_SETUP.md. Keep secrets outside source control.
EARIST_GOOGLE_DRIVE_ENABLED=0
EARIST_GOOGLE_CLIENT_ID=
EARIST_GOOGLE_CLIENT_SECRET=
EARIST_GOOGLE_REDIRECT_URI=
# Exactly 64 hexadecimal characters (32 random bytes); used to encrypt refresh tokens.
EARIST_GOOGLE_TOKEN_ENCRYPTION_KEY=

# Development/Production Mode
APP_ENV=development
APP_DEBUG=true

# Set to 0 only to skip email verification at login on a local development site.
# Production and non-local SITE_URL values always require verification.
REQUIRE_EMAIL_VERIFICATION=1
